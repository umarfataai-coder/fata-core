name: Fata AI CI/CD Pipeline

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-policy: '3.10'

    - name: Install Dependencies
      run: |
        python -m pip install --upgrade pip
        pip install pytest torch fastapi redis

    - name: Run Architecture Unit Tests
      run: |
        # Gwajin tabbatar da cewa PyTorch Transformer na Fata yana aiki ba kuskure
        python -c "import torch; from model.transformer import FataEngineModel; m = FataEngineModel(50257, 768, 2, 4, 1024); print('Fata Engine Test Passed!')"

  deploy:
    needs: build-and-test
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'

    steps:
    - name: Deploying Fata AI to Global Cloud Infrastructure
      run: |
        echo "Ana tura Fata AI zuwa gidan yanar gizo na duniya..."
        # Anan za mu saita hanyar haɗawa da Server dinmu ta SSH ko Kubernetes